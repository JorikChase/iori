# generated by site.py — cross-domain 301s for iori.me
# (pages whose canonical home is the other domain)
@x_audio {
	path /audio/*
	not {
		header Sec-Fetch-Dest script
		header Sec-Fetch-Dest worker
		header Sec-Fetch-Dest sharedworker
		header Sec-Fetch-Dest serviceworker
		header Sec-Fetch-Dest style
		header Sec-Fetch-Dest image
		header Sec-Fetch-Dest font
		header Sec-Fetch-Dest iframe
		header Sec-Fetch-Dest frame
		header Sec-Fetch-Dest embed
		header Sec-Fetch-Dest object
		header Sec-Fetch-Dest empty
		header Sec-Fetch-Dest audio
		header Sec-Fetch-Dest video
		header Sec-Fetch-Dest track
		header Sec-Fetch-Dest manifest
		header Sec-Fetch-Dest audioworklet
		header Sec-Fetch-Dest paintworklet
		header Sec-Fetch-Dest xslt
	}
}
redir @x_audio https://3die.fr{uri} permanent
@x_blackjach {
	path /blackjach/*
	not {
		header Sec-Fetch-Dest script
		header Sec-Fetch-Dest worker
		header Sec-Fetch-Dest sharedworker
		header Sec-Fetch-Dest serviceworker
		header Sec-Fetch-Dest style
		header Sec-Fetch-Dest image
		header Sec-Fetch-Dest font
		header Sec-Fetch-Dest iframe
		header Sec-Fetch-Dest frame
		header Sec-Fetch-Dest embed
		header Sec-Fetch-Dest object
		header Sec-Fetch-Dest empty
		header Sec-Fetch-Dest audio
		header Sec-Fetch-Dest video
		header Sec-Fetch-Dest track
		header Sec-Fetch-Dest manifest
		header Sec-Fetch-Dest audioworklet
		header Sec-Fetch-Dest paintworklet
		header Sec-Fetch-Dest xslt
	}
}
redir @x_blackjach https://3die.fr{uri} permanent
